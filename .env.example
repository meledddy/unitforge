NEXT_PUBLIC_APP_NAME=Unitforge
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: when set, this email appears as a secondary contact on public pages.
NEXT_PUBLIC_SALES_EMAIL=
# For hosted Postgres providers, prefer an explicit SSL mode such as:
# DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/unitforge
AUTH_BOOTSTRAP_PASSWORD=change-me-for-local-login
# Server-only, comma-separated emails allowed to review access requests.
UNITFORGE_ADMIN_EMAILS=
# Set only for the manual onboarding command; never pass passwords in CLI arguments.
# PILOT_ONBOARDING_PASSWORD=use-a-unique-password-with-at-least-12-characters
# Enable only behind a trusted ingress that overwrites forwarding headers.
TRUST_PROXY_HEADERS=false
# Set only when intentionally provisioning the dedicated sales-demo tenant.
# SALES_DEMO_PASSWORD=use-a-unique-password-with-at-least-12-characters
ANALYTICS_WRITE_KEY=

# Optional pilot alert hook. Sends safe lead-created metadata only; lead PII stays in Unitforge.
PRICE_SHEET_LEAD_NOTIFICATION_WEBHOOK_URL=
PRICE_SHEET_LEAD_NOTIFICATION_WEBHOOK_SECRET=
# Optional sales/contact alert hook. Sends safe request metadata only; submitted PII stays in Unitforge.
ACCESS_REQUEST_NOTIFICATION_WEBHOOK_URL=
ACCESS_REQUEST_NOTIFICATION_WEBHOOK_SECRET=
